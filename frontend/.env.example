# Database (see ../database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rizurf_feedback

# Rizurf gateway (see PulseDiscussion/MICROAPP_AUTH.md)
GATEWAY_URL=http://127.0.0.1:4301
# This app's own address, exactly as registered with the gateway
# (baseUrl / app_url). Local dev: the Vite dev server's origin, since
# that's what the browser and the gateway both see, even though the API
# itself listens on a different port (see vite.config.ts's proxy).
PUBLIC_URL=http://localhost:5173
# The service id the gateway will issue tokens for (the `aud` claim) —
# must match whatever id this service registers under.
SERVICE_ID=rizurf-feedback-api
# Random string used to HMAC-sign our own session cookie. Generate a real
# one for every environment, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Local dev API server port (api/dev-server.js only — unused on Vercel)
PORT=4000

# Intern roster sync (optional; skipped if CLIENT_SECRET is empty).
# CLIENT_ID defaults to SERVICE_ID.
CLIENT_ID=
CLIENT_SECRET=
INTERN_API_URL=https://intern-database.vercel.app
