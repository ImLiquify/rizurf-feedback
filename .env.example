# Copy to .env and fill in. Do not commit .env.

# PulseFeedback microapp + Rizurf gateway session
SERVICE_ID=pulsefeedback
GATEWAY_URL=https://your-gateway.example
PUBLIC_URL=http://127.0.0.1:3001
SESSION_SECRET=change-me-to-a-long-random-value
PORT=3001

# Intern-database API pull (OAuth2 client-credentials via the gateway).
# CLIENT_ID / CLIENT_SECRET are the gateway client registered with the
# `intern:read` scope. INTERN_API_AUDIENCE is the token `aud` the intern
# service expects (its service id).
INTERN_API_BASE_URL=https://intern-database.vercel.app
INTERN_API_AUDIENCE=intern-database
CLIENT_ID=your-gateway-client-id
CLIENT_SECRET=your-gateway-client-secret

# Local MySQL (XAMPP) for the feedback store
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pulsefeedback
DB_USER=root
DB_PASSWORD=
